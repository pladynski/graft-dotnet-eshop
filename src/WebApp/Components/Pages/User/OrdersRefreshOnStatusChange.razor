@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@implements IDisposable
@code {
    private PeriodicTimer? timer;
    private readonly CancellationTokenSource stopping = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Order status used to arrive on the RabbitMQ event bus and refresh this circuit.
        // RabbitmqPlugin delivers a call to a Gateway process, which does not own the circuit,
        // so the orders page polls instead.
        var buyerId = await AuthenticationStateProvider.GetBuyerIdAsync();
        if (string.IsNullOrEmpty(buyerId))
        {
            return;
        }

        timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        if (timer is null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(stopping.Token))
            {
                await InvokeAsync(Refresh);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Refresh()
    {
        try
        {
            Nav.Refresh();
        }
        catch (Exception ex)
        {
            _ = DispatchExceptionAsync(ex);
        }
    }

    public void Dispose()
    {
        stopping.Cancel();
        timer?.Dispose();
        stopping.Dispose();
    }
}
